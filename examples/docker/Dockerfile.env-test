# Dockerfile for testing environment variable passing
FROM node:20-alpine

WORKDIR /app

# Create a simple server that prints environment variables
RUN echo 'const http = require("http"); \
const server = http.createServer((req, res) => { \
  const env = { \
    MY_VAR: process.env.MY_VAR || "not set", \
    ANOTHER_VAR: process.env.ANOTHER_VAR || "not set" \
  }; \
  console.log(`Request received. Env vars:`, env); \
  res.writeHead(200, {"Content-Type": "application/json"}); \
  res.end(JSON.stringify(env)); \
}); \
server.listen(3000, () => console.log("Server running on port 3000. MY_VAR=" + (process.env.MY_VAR || "not set")));' > server.js

EXPOSE 3000

CMD ["node", "server.js"]
